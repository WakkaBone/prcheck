{
  "name": "prcheck",
  "version": "0.1.0",
  "description": "Detect semantic drift in pull requests before it becomes a merge disaster",
  "type": "module",
  "bin": {
    "prcheck": "./dist/bin/prcheck.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["github", "pull-request", "git", "developer-tools", "cli", "drift"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
